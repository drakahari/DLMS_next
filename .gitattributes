# Keep source releases focused on supported application source and verification.
# `git archive` already omits .git and untracked/ignored local files.
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/archive export-ignore
/archive/** export-ignore
/legacy_library_ui_2026-08-21.txt export-ignore
/MATCHING_PROTOTYPE_NOTES.md export-ignore
/README_MEDICAL_V0.4.md export-ignore
/README_MEDICAL_V0.5.md export-ignore
/docs/screenshots/requirements.txt export-ignore

# Final-package text assets use stable bytes across checkout platforms.
/release_assets/*.txt text eol=lf

# A unified diff's blank context line is one mandatory space. Check its added
# source lines and exact publication tree separately in the CI patch validator.
# Do not extend this exception to source files or other patches/reports.
/reports/private-consolidation/PROPOSED.patch -whitespace
