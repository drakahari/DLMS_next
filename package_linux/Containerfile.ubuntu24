FROM docker.io/library/ubuntu@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake pkg-config ca-certificates curl git binutils zstd xz-utils python3 python3-venv libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev libffi-dev liblzma-dev libncurses-dev libzstd-dev uuid-dev libtiff-dev libjpeg-dev libpng-dev libwebp-dev libopenjp2-7-dev libgif-dev libarchive-dev libcurl4-openssl-dev libgl1 libegl1 libopengl0 libnss3 libasound2t64 libxkbcommon0 libxcb-cursor0 libxcb-xkb1 libxkbcommon-x11-0 libxcomposite1 libxdamage1 libxrandr2 libxi6 libxtst6 libfontconfig1 libdbus-1-3 libvulkan1 fonts-dejavu-core libglib2.0-0t64 libxfixes3 libxkbfile1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libxcb-shape0 libgbm1 libdrm2 libxss1 libxshmfence1 libsm6 libice6 libudev1
COPY Python-3.14.7.tar.xz tesseract-5.5.3.tar.gz leptonica-1.87.0.tar.gz /inputs/
RUN printf '%s  %s\n' '3b48dac8fb59f62eaa67ac83c1eb12bda1b7a08406dd286e252c11a66be27f81' /inputs/Python-3.14.7.tar.xz '9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884' /inputs/tesseract-5.5.3.tar.gz 'fa2b40c5caea96d1bb93a97486262aed8731b69ce25a84a6bf5d25323e33f631' /inputs/leptonica-1.87.0.tar.gz | sha256sum -c -
RUN mkdir /src && cd /src && tar -xf /inputs/Python-3.14.7.tar.xz && cd Python-3.14.7 && ./configure --prefix=/opt/python --enable-shared --with-ensurepip=install LDFLAGS='-Wl,-rpath=/opt/python/lib' && make -j8 && make install
RUN cd /src && tar -xf /inputs/leptonica-1.87.0.tar.gz && cmake -S leptonica-1.87.0 -B lept-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/lept -DBUILD_SHARED_LIBS=ON -DBUILD_PROG=OFF && cmake --build lept-build -j8 && cmake --install lept-build
RUN cd /src && tar -xf /inputs/tesseract-5.5.3.tar.gz && PKG_CONFIG_PATH=/opt/lept/lib/pkgconfig cmake -S tesseract-5.5.3 -B tess-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/ocr -DCMAKE_PREFIX_PATH=/opt/lept -DCMAKE_INSTALL_RPATH=/opt/lept/lib -DBUILD_TRAINING_TOOLS=OFF -DBUILD_TESTS=OFF && cmake --build tess-build -j8 && cmake --install tess-build
COPY requirements-build-lock.txt /inputs/
RUN /opt/python/bin/python3.14 -m venv /opt/build-venv && /opt/build-venv/bin/python -m pip install --disable-pip-version-check --no-cache-dir --only-binary=:all: -r /inputs/requirements-build-lock.txt && /opt/build-venv/bin/python -m pip check && /opt/build-venv/bin/python -m pip freeze > /inputs/resolved-python.txt && dpkg-query -W > /inputs/resolved-debian.txt
ENV PATH=/opt/build-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /work
